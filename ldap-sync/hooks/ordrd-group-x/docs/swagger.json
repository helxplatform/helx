{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/hook": {
            "post": {
                "description": "Accepts LDAP payload and returns transformed data.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "hook"
                ],
                "summary": "Process LDAP hook payload",
                "parameters": [
                    {
                        "description": "LDAP Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.HookRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.HookResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.Derived": {
            "type": "object",
            "properties": {
                "baseDN": {
                    "type": "string",
                    "example": "ou=people,dc=unc,dc=edu"
                },
                "filter": {
                    "type": "string",
                    "example": "(|(pid=713272486)(pid=709909262)... )"
                },
                "id": {
                    "type": "string",
                    "example": "ordrd-members"
                },
                "refresh": {
                    "type": "integer",
                    "example": 10
                }
            }
        },
        "main.ErrorResponse": {
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            }
        },
        "main.HookRequest": {
            "type": "object",
            "properties": {
                "content": {
                    "type": "object",
                    "additionalProperties": true
                },
                "dn": {
                    "type": "string",
                    "example": "cn=unc:app:renci:ordrd-example,ou=Groups,dc=unc,dc=edu"
                }
            }
        },
        "main.HookResponse": {
            "type": "object",
            "properties": {
                "derived": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.Derived"
                    }
                },
                "reset": {
                    "type": "boolean"
                },
                "transformed": {}
            }
        }
    }
}