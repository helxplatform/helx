dn: olcDatabase={2}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange
  by self write
  by dn="cn=admin,dc=example,dc=org" write
  by anonymous auth
  by * none
olcAccess: {1}to dn.base="ou=external,ou=users,dc=example,dc=org" attrs=children
  by dn="cn=admin,dc=example,dc=org" write
  by dn="cn=appstore,dc=example,dc=org" write
  by * break
olcAccess: {2}to dn.subtree="ou=users,dc=example,dc=org"
  by dn="cn=admin,dc=example,dc=org" write
  by dnattr=creatorsName write
  by anonymous read
  by users read
  by * none
olcAccess: {3}to dn.base="cn=helx-users,ou=groups,dc=example,dc=org" attrs=memberUid
  by dn="cn=admin,dc=example,dc=org" write
  by dn="cn=appstore,dc=example,dc=org" =arscxd
  by anonymous read
  by users read
  by * none
olcAccess: {4}to dn.subtree="ou=groups,dc=example,dc=org"
  by dn="cn=admin,dc=example,dc=org" write
  by anonymous read
  by users read
  by * none
olcAccess: {5}to *
  by dn="cn=admin,dc=example,dc=org" write
  by * none
