#!/usr/bin/env bash

if [ -z "$1" ]
  then
    echo "Usage: populate_env /path/to/output/env.json"
    exit 1
fi

workspaces_enabled="${REACT_APP_WORKSPACES_ENABLED:-true}"
search_enabled="${REACT_APP_SEMANTIC_SEARCH_ENABLED:-true}"
default_space="${REACT_APP_DEFAULT_SPACE:-search}"
search_url="${REACT_APP_HELX_SEARCH_URL}"
brand_name="${REACT_APP_UI_BRAND_NAME}"
tranql_url="${REACT_APP_TRANQL_URL:-/tranql}"
hidden_result_tabs="${REACT_APP_HIDDEN_RESULT_TABS}"
deployment_namespace="${REACT_APP_DEPLOYMENT_NAMESPACE}"
appstore_asset_base_url="${REACT_APP_APPSTORE_ASSET_BASE_URL:-https://raw.githubusercontent.com/helxplatform/appstore}"
appstore_asset_branch="${REACT_APP_APPSTORE_ASSET_BRANCH:-master}"
analytics_enabled="${REACT_APP_ANALYTICS_ENABLED:-false}"
analytics_platform="${REACT_APP_ANALYTICS_PLATFORM}"
analytics_token="${REACT_APP_ANALYTICS_TOKEN}"
meta_title="${META_TITLE:-HeLx UI}"
meta_description="${META_DESCRIPTION:-HeLx UI}"
login_title="${REACT_APP_LOGIN_TITLE}"
support_help_url="${REACT_APP_SUPPORT_HELP_PORTAL_URL}"
support_user_guide_url="${REACT_APP_SUPPORT_USER_GUIDE_URL}"
support_faqs_url="${REACT_APP_SUPPORT_FAQS_URL}"
support_intro_video_url="${REACT_APP_SUPPORT_INTRO_VIDEO_URL}"
support_howto_video_url="${REACT_APP_SUPPORT_HOWTO_VIDEO_URL}"
search_tour_enabled="${REACT_APP_SEARCH_TOUR_ENABLED:-false}"


template='{
    "brand": "%BRAND%",
    "color_scheme": { "primary": "#8a5a91", "secondary": "#505057" },
    "search_url": "%SEARCH_URL%",
    "search_enabled": "%SEARCH_ENABLED%",
    "workspaces_enabled": "%WORKSPACES_ENABLED%",
    "default_space": "%DEFAULT_SPACE%",
    "tranql_url": "%TRANQL_URL%",
    "analytics": {
      "enabled": %ANALYTICS_ENABLED%,
      "platform": "%ANALYTICS_PLATFORM%",
      "token": "%ANALYTICS_TOKEN%"
    },
    "hidden_result_tabs": "%HIDDEN_RESULT_TABS%",
    "deployment_namespace": "%DEPLOYMENT_NAMESPACE%",
    "appstore_asset_base_url": "%APPSTORE_ASSET_BASE_URL%",
    "appstore_asset_branch": "%APPSTORE_ASSET_BRANCH%",
    "meta": {
      "title": "%META_TITLE%",
      "description": "%META_DESCRIPTION%"
    },
    "login_title": "%LOGIN_TITLE%",
    "support": {
      "help_portal_url": "%SUPPORT_HELP_PORTAL_URL%",
      "user_guide_url": "%SUPPORT_USER_GUIDE_URL%",
      "faqs_url": "%SUPPORT_FAQS_URL%",
      "intro_video_url": "%SUPPORT_INTRO_VIDEO_URL%",
      "howto_video_url": "%SUPPORT_HOWTO_VIDEO_URL%"
    },
    "search_tour_enabled": "%SEARCH_TOUR_ENABLED%"
}'

# UNCDSR-182 fallout, found 2026-11-06: sed with "/" as its delimiter breaks
# as soon as a replacement value contains a "/" -- which REACT_APP_HELX_SEARCH_URL,
# REACT_APP_APPSTORE_ASSET_BASE_URL, and the support/video URLs all routinely do
# (e.g. https://cdsr-staging.renci.unc.edu/artifact/appstore), aborting with
# "bad option in substitution expression" and leaving env.json empty -- with
# no error surfaced anywhere nginx's own logs are visible, since this runs
# before nginx starts. Confirmed live: this has been silently failing on any
# deployment that sets one of those URLs to anything other than sed's own
# escaped-slash default. Bash's own string substitution has no delimiter to
# collide with (and, unlike sed's replacement text, no special meaning for
# "&" either), so it's used here instead of sed.
output="$template"
output="${output//%WORKSPACES_ENABLED%/$workspaces_enabled}"
output="${output//%SEARCH_ENABLED%/$search_enabled}"
output="${output//%DEFAULT_SPACE%/$default_space}"
output="${output//%SEARCH_URL%/$search_url}"
output="${output//%BRAND%/$brand_name}"
output="${output//%HIDDEN_RESULT_TABS%/$hidden_result_tabs}"
output="${output//%TRANQL_URL%/$tranql_url}"
output="${output//%DEPLOYMENT_NAMESPACE%/$deployment_namespace}"
output="${output//%APPSTORE_ASSET_BASE_URL%/$appstore_asset_base_url}"
output="${output//%APPSTORE_ASSET_BRANCH%/$appstore_asset_branch}"
output="${output//%ANALYTICS_ENABLED%/$analytics_enabled}"
output="${output//%ANALYTICS_PLATFORM%/$analytics_platform}"
output="${output//%ANALYTICS_TOKEN%/$analytics_token}"
output="${output//%META_TITLE%/$meta_title}"
output="${output//%META_DESCRIPTION%/$meta_description}"
output="${output//%LOGIN_TITLE%/$login_title}"
output="${output//%SUPPORT_HELP_PORTAL_URL%/$support_help_url}"
output="${output//%SUPPORT_USER_GUIDE_URL%/$support_user_guide_url}"
output="${output//%SUPPORT_FAQS_URL%/$support_faqs_url}"
output="${output//%SUPPORT_INTRO_VIDEO_URL%/$support_intro_video_url}"
output="${output//%SUPPORT_HOWTO_VIDEO_URL%/$support_howto_video_url}"
output="${output//%SEARCH_TOUR_ENABLED%/$search_tour_enabled}"

echo "$output" > "$1"